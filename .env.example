OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional for public PR previews; required for private PRs and posting.
GITHUB_TOKEN=
# Comma-separated owner/repository entries required for webhooks and publication.
ALLOWED_REPOSITORIES=
AUTO_PUBLISH=false
GITHUB_WEBHOOK_SECRET=
# Required for access from another computer. Leave blank for loopback-only development.
API_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1
# DATA_DIR=/private/path/to/review-storage
